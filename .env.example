# Gemini API key. Never commit a real key. Copy this file to .env.local.
GEMINI_API_KEY=

# Primary model. Default is Gemini 3.8 Flash.
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated models tried after the primary returns 503, 504, or
# repeated 500s. Default is Gemini 3.6 Flash, then Gemini 3.5 Flash-Lite.
# Leave the value empty to retry the primary only.
# gemini-flash-latest is not useful here: it currently points at gemini-3.8-flash.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
